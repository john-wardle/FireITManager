<Window x:Class="FireITManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FireIT Manager"
        Width="1220"
        Height="760"
        MinWidth="960"
        MinHeight="620">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewIncidentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveIncidentCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportBundleCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintSummaryCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Incident" Command="{Binding NewIncidentCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open Cache" Command="{Binding LoadCacheCommand}" />
                <MenuItem Header="_Save" Command="{Binding SaveIncidentCommand}" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="_Print Summary" Command="{Binding PrintSummaryCommand}" InputGestureText="Ctrl+P" />
                <MenuItem Header="_Export Incident Bundle" Command="{Binding ExportBundleCommand}" InputGestureText="Ctrl+E" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Validate" Command="{Binding ValidateCommand}" />
                <MenuItem Header="_Reload From Server" Command="{Binding RefreshCommand}" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Incident" Command="{Binding SelectIncidentWorkspaceCommand}" />
                <MenuItem Header="_Camp Ops" Command="{Binding SelectCampOpsWorkspaceCommand}" />
                <MenuItem Header="_Inventory" Command="{Binding SelectInventoryWorkspaceCommand}" />
                <MenuItem Header="_Network" Command="{Binding SelectNetworkWorkspaceCommand}" />
                <MenuItem Header="_Outputs" Command="{Binding SelectOutputsWorkspaceCommand}" />
            </MenuItem>
            <MenuItem Header="_Incident">
                <MenuItem Header="_Save Incident Summary" Command="{Binding SaveIncidentCommand}" />
                <MenuItem Header="_Validate Incident" Command="{Binding ValidateCommand}" />
            </MenuItem>
            <MenuItem Header="_Camp Ops">
                <MenuItem Header="_Refresh Camps" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="I_nventory">
                <MenuItem Header="_Refresh Inventory" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="_Network">
                <MenuItem Header="_Refresh Network" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="_Outputs">
                <MenuItem Header="_Print Summary" Command="{Binding PrintSummaryCommand}" />
                <MenuItem Header="_Export Incident Bundle" Command="{Binding ExportBundleCommand}" />
                <MenuItem Header="_Open Output Folder" Command="{Binding OpenOutputFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding ConnectionBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ConnectionStatus}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding LastSyncText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding UserRole}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Server" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Grid.Column="1" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="User" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Grid.Column="3" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="Role" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox Grid.Column="5" ItemsSource="{Binding Roles}" SelectedItem="{Binding UserRole, Mode=TwoWay}" />
                    <Button Grid.Column="6" Content="Connect" Command="{Binding ConnectCommand}" Margin="14,0,8,0" />
                    <Button Grid.Column="7" Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
                </Grid>
            </Border>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedWorkspaceIndex, Mode=TwoWay}" Margin="12">
                <TabItem Header="Incident">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Incident Summary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                                <TextBlock Grid.Row="1" Text="Incident Number" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding IncidentNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />

                                <TextBlock Grid.Row="2" Text="Name" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IncidentName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="3" Text="Agency" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Agency, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="4" Text="Operational Start UTC" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OperationalPeriodStartUtcText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="5" Text="Operational End UTC" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OperationalPeriodEndUtcText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,10,0,0" />

                                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,16,0,0">
                                    <Button Content="Save" Command="{Binding SaveIncidentCommand}" />
                                    <Button Content="Validate" Command="{Binding ValidateCommand}" />
                                    <Button Content="New" Command="{Binding NewIncidentCommand}" />
                                    <TextBlock Text="{Binding IncidentVersionText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Validation" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding ValidationMessages}" MinHeight="110" />
                                <TextBlock Grid.Row="2" Text="Live Activity" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" />
                                <ListBox Grid.Row="3" ItemsSource="{Binding ActivityLog}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Camp Ops">
                    <DataGrid ItemsSource="{Binding Camps}" Margin="6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Camp" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                            <DataGridTextColumn Header="Updated UTC" Binding="{Binding UpdatedAtUtc}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Inventory">
                    <DataGrid ItemsSource="{Binding Devices}" Margin="6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                            <DataGridTextColumn Header="Updated UTC" Binding="{Binding UpdatedAtUtc}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Network">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Networks}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Network" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Links}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Link" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Outputs">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Export Bundle" Command="{Binding ExportBundleCommand}" />
                            <Button Content="Print Summary" Command="{Binding PrintSummaryCommand}" />
                            <Button Content="Open Folder" Command="{Binding OpenOutputFolderCommand}" />
                            <TextBlock Text="{Binding LastOutputPath}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLog}" />
                    </Grid>
                </TabItem>

                <TabItem Header="Live">
                    <DataGrid ItemsSource="{Binding RealtimeConnections}" Margin="6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User" Binding="{Binding UserId}" Width="*" />
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding ClientKind}" Width="120" />
                            <DataGridTextColumn Header="Address" Binding="{Binding RemoteAddress}" Width="160" />
                            <DataGridTextColumn Header="Connected UTC" Binding="{Binding ConnectedAtUtc}" Width="190" />
                            <DataGridTextColumn Header="Last Seen UTC" Binding="{Binding LastSeenAtUtc}" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
