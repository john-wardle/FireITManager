<Window x:Class="FireITManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FireIT Manager"
        Width="1220"
        Height="760"
        MinWidth="960"
        MinHeight="620">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewIncidentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveIncidentCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportBundleCommand}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintSummaryCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Incident" Command="{Binding NewIncidentCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open Cache" Command="{Binding LoadCacheCommand}" />
                <MenuItem Header="_Save" Command="{Binding SaveIncidentCommand}" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="_Print Summary" Command="{Binding PrintSummaryCommand}" InputGestureText="Ctrl+P" />
                <MenuItem Header="_Export Incident Bundle" Command="{Binding ExportBundleCommand}" InputGestureText="Ctrl+E" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Validate" Command="{Binding ValidateCommand}" />
                <MenuItem Header="_Reload From Server" Command="{Binding RefreshCommand}" InputGestureText="F5" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Incident" Command="{Binding SelectIncidentWorkspaceCommand}" />
                <MenuItem Header="_Camp Ops" Command="{Binding SelectCampOpsWorkspaceCommand}" />
                <MenuItem Header="_Inventory" Command="{Binding SelectInventoryWorkspaceCommand}" />
                <MenuItem Header="_Map" Command="{Binding SelectMapWorkspaceCommand}" />
                <MenuItem Header="_Network" Command="{Binding SelectNetworkWorkspaceCommand}" />
                <MenuItem Header="_Outputs" Command="{Binding SelectOutputsWorkspaceCommand}" />
            </MenuItem>
            <MenuItem Header="_Incident">
                <MenuItem Header="_Save Incident Summary" Command="{Binding SaveIncidentCommand}" />
                <MenuItem Header="_Validate Incident" Command="{Binding ValidateCommand}" />
            </MenuItem>
            <MenuItem Header="_Camp Ops">
                <MenuItem Header="_Refresh Camps" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="I_nventory">
                <MenuItem Header="_Refresh Inventory" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="_Network">
                <MenuItem Header="_Refresh Network" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="_Outputs">
                <MenuItem Header="_Print Summary" Command="{Binding PrintSummaryCommand}" />
                <MenuItem Header="_Export Incident Bundle" Command="{Binding ExportBundleCommand}" />
                <MenuItem Header="_Open Output Folder" Command="{Binding OpenOutputFolderCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding ConnectionBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ConnectionStatus}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding LastSyncText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding UserRole}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Server" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Grid.Column="1" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="User" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox Grid.Column="3" Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4" Text="Role" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox Grid.Column="5" ItemsSource="{Binding Roles}" SelectedItem="{Binding UserRole, Mode=TwoWay}" />
                    <Button Grid.Column="6" Content="Connect" Command="{Binding ConnectCommand}" Margin="14,0,8,0" />
                    <Button Grid.Column="7" Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
                </Grid>
            </Border>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedWorkspaceIndex, Mode=TwoWay}" Margin="12">
                <TabItem Header="Incident">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Incident Summary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

                                <TextBlock Grid.Row="1" Text="Incident Number" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding IncidentNumber, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" />

                                <TextBlock Grid.Row="2" Text="Name" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IncidentName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="3" Text="Agency" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Agency, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="4" Text="Operational Start UTC" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OperationalPeriodStartUtcText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="5" Text="Operational End UTC" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OperationalPeriodEndUtcText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}" Margin="0,10,0,0" />

                                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,16,0,0">
                                    <Button Content="Save" Command="{Binding SaveIncidentCommand}" />
                                    <Button Content="Validate" Command="{Binding ValidateCommand}" />
                                    <Button Content="New" Command="{Binding NewIncidentCommand}" />
                                    <TextBlock Text="{Binding IncidentVersionText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Validation" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ListBox Grid.Row="1" ItemsSource="{Binding ValidationMessages}" MinHeight="110" />
                                <TextBlock Grid.Row="2" Text="Live Activity" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" />
                                <ListBox Grid.Row="3" ItemsSource="{Binding ActivityLog}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Camp Ops">
                    <DataGrid ItemsSource="{Binding Camps}" Margin="6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Camp" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                            <DataGridTextColumn Header="Updated UTC" Binding="{Binding UpdatedAtUtc}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Inventory">
                    <DataGrid ItemsSource="{Binding Devices}" Margin="6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                            <DataGridTextColumn Header="Updated UTC" Binding="{Binding UpdatedAtUtc}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Map">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Search" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" />
                                <TextBox Width="210" Text="{Binding MapSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />

                                <TextBlock Text="Status" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" />
                                <ComboBox Width="136" ItemsSource="{Binding MapStatusFilters}" SelectedItem="{Binding MapStatusFilter, Mode=TwoWay}" Margin="0,0,12,0" />

                                <TextBlock Text="Type" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" />
                                <ComboBox Width="136" ItemsSource="{Binding MapTypeFilters}" SelectedItem="{Binding MapTypeFilter, Mode=TwoWay}" Margin="0,0,12,0" />

                                <TextBlock Text="Network" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" />
                                <ComboBox Width="164" ItemsSource="{Binding MapNetworkFilters}" SelectedItem="{Binding MapNetworkFilter, Mode=TwoWay}" Margin="0,0,12,0" />

                                <TextBlock Text="Camp" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" />
                                <ComboBox Width="150" ItemsSource="{Binding MapCampFilters}" SelectedItem="{Binding MapCampFilter, Mode=TwoWay}" Margin="0,0,12,0" />

                                <TextBlock Text="Device" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,6,0" />
                                <ComboBox Width="150" ItemsSource="{Binding MapDeviceTypeFilters}" SelectedItem="{Binding MapDeviceTypeFilter, Mode=TwoWay}" Margin="0,0,12,0" />

                                <Button Content="Clear" Command="{Binding ClearMapFiltersCommand}" />
                                <TextBlock Text="{Binding MapSummaryText}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" />
                            </WrapPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="350" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Grid Width="{Binding MapCanvasWidth}" Height="{Binding MapCanvasHeight}">
                                        <Canvas Background="#F8FAFC" Width="{Binding MapCanvasWidth}" Height="{Binding MapCanvasHeight}" />

                                        <ItemsControl ItemsSource="{Binding MapLinks}" Width="{Binding MapCanvasWidth}" Height="{Binding MapCanvasHeight}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="{Binding MapCanvasWidth}" Height="{Binding MapCanvasHeight}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="0" />
                                                    <Setter Property="Canvas.Top" Value="0" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Line X1="{Binding SourceX}"
                                                          Y1="{Binding SourceY}"
                                                          X2="{Binding TargetX}"
                                                          Y2="{Binding TargetY}"
                                                          Stroke="{Binding StatusBrush}"
                                                          StrokeThickness="3"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Triangle">
                                                        <Line.ToolTip>
                                                            <StackPanel MaxWidth="360">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding DirectionLabel}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding StatusLabel}" />
                                                                <TextBlock Text="{Binding LastSeenText}" Foreground="{StaticResource MutedTextBrush}" />
                                                            </StackPanel>
                                                        </Line.ToolTip>
                                                    </Line>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding MapLinks}" Width="{Binding MapCanvasWidth}" Height="{Binding MapCanvasHeight}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="{Binding MapCanvasWidth}" Height="{Binding MapCanvasHeight}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding LabelX}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding LabelY}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="4,2" MaxWidth="240">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DirectionLabel}" FontSize="11" TextWrapping="Wrap" />
                                                            <Border Grid.Column="1" Background="{StaticResource WarningBrush}" CornerRadius="2" Padding="4,1" VerticalAlignment="Top" Margin="6,0,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ManualOverride}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding ManualOverrideBadge}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding MapNodes}" Width="{Binding MapCanvasWidth}" Height="{Binding MapCanvasHeight}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Width="{Binding MapCanvasWidth}" Height="{Binding MapCanvasHeight}" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="{Binding Width}"
                                                            Height="{Binding Height}"
                                                            Padding="0"
                                                            Margin="0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Command="{Binding DataContext.SelectMapNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Border Background="{StaticResource PanelBrush}"
                                                                BorderBrush="{Binding StatusBrush}"
                                                                BorderThickness="2"
                                                                Padding="8"
                                                                Width="{Binding Width}"
                                                                Height="{Binding Height}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="8" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Background="{Binding StatusBrush}" Margin="-8,-8,8,-8" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding ObjectType}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Background="{StaticResource WarningBrush}" CornerRadius="2" Padding="4,1" VerticalAlignment="Top" Margin="6,0,0,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ManualOverride}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding ManualOverrideBadge}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <Button.ToolTip>
                                                            <StackPanel MaxWidth="360">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding ObjectType}" />
                                                                <TextBlock Text="{Binding StatusLabel}" />
                                                                <TextBlock Text="{Binding LastSeenText}" Foreground="{StaticResource MutedTextBrush}" />
                                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="190" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedMapDetailTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding SelectedMapDetailText}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="2" ItemsSource="{Binding MapLinks}" SelectedItem="{Binding SelectedMapLink, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                                        <DataGridTextColumn Header="Override" Binding="{Binding ManualOverrideBadge}" Width="70" />
                                        <DataGridTextColumn Header="Link" Binding="{Binding Title}" Width="*" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding SelectedMapHistoryTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <ListBox Grid.Row="1" ItemsSource="{Binding MapStatusHistory}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="6" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                                    <ItemsControl ItemsSource="{Binding StatusLegend}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Label}" Width="86" />
                                                    <TextBlock Text="{Binding Meaning}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Network">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Networks}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Network" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Links}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Link" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Outputs">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Export Bundle" Command="{Binding ExportBundleCommand}" />
                            <Button Content="Print Summary" Command="{Binding PrintSummaryCommand}" />
                            <Button Content="Open Folder" Command="{Binding OpenOutputFolderCommand}" />
                            <TextBlock Text="{Binding LastOutputPath}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding ActivityLog}" />
                    </Grid>
                </TabItem>

                <TabItem Header="Live">
                    <DataGrid ItemsSource="{Binding RealtimeConnections}" Margin="6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="User" Binding="{Binding UserId}" Width="*" />
                            <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding ClientKind}" Width="120" />
                            <DataGridTextColumn Header="Address" Binding="{Binding RemoteAddress}" Width="160" />
                            <DataGridTextColumn Header="Connected UTC" Binding="{Binding ConnectedAtUtc}" Width="190" />
                            <DataGridTextColumn Header="Last Seen UTC" Binding="{Binding LastSeenAtUtc}" Width="190" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
